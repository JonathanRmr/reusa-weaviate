# Plantilla de credenciales. Copiar a .env en la raiz del repositorio y rellenar.
# El .env NUNCA se sube: esta en .gitignore.
#
# Este unico archivo lo leen las dos partes del proyecto:
#   - /ingesta  (Fase 1) necesita WEAVIATE_URL y WEAVIATE_API_KEY
#   - /api      (Fase 2) necesita ademas PORT y CORS_ORIGIN

# REST Endpoint URL del cluster, desde https://console.weaviate.cloud
# Con https:// y sin barra al final.
WEAVIATE_URL=

# Para INGESTAR hace falta la Admin API key.
# Para el perfil "nube" del docker-compose va la clave de SOLO LECTURA (roadmap 5.1).
WEAVIATE_API_KEY=

# --- Solo para /api ---

# Puerto en el que escucha Express. El servidor escucha en 0.0.0.0 (roadmap 2.6).
PORT=3001

# Origen permitido para CORS en desarrollo (Vite suele usar 5173).
# En produccion nginx sirve todo bajo el mismo origen y esto no hace falta.
CORS_ORIGIN=http://localhost:5173
