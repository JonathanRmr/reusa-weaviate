# Copiar a .env (NUNCA versionar .env con valores reales)

# REST Endpoint URL del clúster, desde console.weaviate.cloud
WEAVIATE_URL=

# Perfil "nube": usar la clave de SOLO LECTURA (rol RBAC), ver roadmap 5.1.
# En desarrollo local contra el propio clúster se puede usar la Admin key temporalmente.
WEAVIATE_API_KEY=

# Puerto en el que escucha Express dentro del contenedor
PORT=3001

# Origen permitido para CORS en desarrollo (ej: http://localhost:5173 para Vite).
# En producción, nginx sirve todo bajo el mismo origen y esto no debería hacer falta.
CORS_ORIGIN=http://localhost:5173
